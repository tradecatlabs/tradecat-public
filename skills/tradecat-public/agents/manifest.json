{
  "schema": "tradecat.agent_manifest.v1",
  "schema_version": "1.0.0",
  "name": "tradecat-public",
  "display_name": "TradeCat Agent Paper Trader",
  "repo_role": "Headless Agent/Hermes paper-trading runtime: online sheets provide public signals, Agents provide Binance public-readonly context and thesis, TradeCat runs schema audit, paper/watch, ledger, risk, reports, and reproducible audit.",
  "skill_root": "skills/tradecat-public",
  "project_root": ".",
  "default_workdir": ".",
  "human_docs": [
    "README.md",
    "AGENTS.md",
    "skills/tradecat-public/references/index.md",
    "skills/tradecat-public/references/hermes-agent-guide.md",
    "skills/tradecat-public/references/private-executor-boundary.md"
  ],
  "agent_docs": [
    "skills/tradecat-public/SKILL.md",
    "skills/tradecat-public/agents/manifest.json",
    "skills/tradecat-public/references/agent-contract.md",
    "skills/tradecat-public/references/hermes-agent-guide.md",
    "skills/tradecat-public/references/private-executor-boundary.md"
  ],
  "agent_profiles": [
    {
      "id": "openai",
      "path": "skills/tradecat-public/agents/openai.yaml",
      "role": "platform adapter"
    },
    {
      "id": "hermes",
      "path": "skills/tradecat-public/agents/hermes.yaml",
      "role": "platform adapter"
    }
  ],
  "skill_package_governance": {
    "shape": "project_with_embedded_hermes_skill",
    "canonical_machine_contract": "skills/tradecat-public/agents/manifest.json",
    "skill_root": "skills/tradecat-public",
    "implementation_project_root": ".",
    "no_second_truth": true,
    "root_responsibilities": [
      "Headless Python Agent runtime at repository root",
      "Online sheet signal-source adapter under src/tradecat_sources",
      "Agent market-context audit, paper/watch, ledger, risk, reports under src/tradecat_auto",
      "Self-contained Binance skill/API snapshots under resources/agent_market_context/binance"
    ],
    "forbidden_root_paths": [
      "SKILL.md",
      "agents",
      "references",
      "src/tradecat_terminal",
      "install.sh",
      "install.ps1",
      "uninstall.sh",
      "uninstall.ps1",
      "scripts/start.sh",
      "scripts/watchdog.sh"
    ],
    "local_runtime_paths": [
      ".runtime/**",
      ".hermes/**",
      ".tradecat/**",
      ".venv/**",
      ".tools/**",
      "project/**",
      "tasks/**"
    ],
    "safety_boundary": "Public repo remains public-readonly plus paper/watch; no Binance keys, no signed requests, no account reads, no real orders."
  },
  "agent_role_profiles": [
    {
      "id": "discretionary_futures_trader",
      "kind": "paper_research_trader_profile",
      "path": "resources/agent_soft_layer/profiles/discretionary-futures-trader.zh.md",
      "bundle_command": "bash scripts/run-tradecat.sh soft-layer --json",
      "contract_schema": "tradecat_auto.agent_soft_layer.v1",
      "activation": "Use only as Agent/Hermes soft prompt for public-readonly market research and paper/watch thesis generation.",
      "real_orders": false,
      "signed_requests": false,
      "reads_api_keys": false,
      "safety_boundary": "Soft role configuration only; deterministic context-audit, risk, paper ledger, and local kill switch remain authoritative."
    }
  ],
  "command_risk_classes": {
    "local_readonly": "Reads local tracked files or ignored runtime metadata only.",
    "network_readonly": "Reads public network resources only.",
    "paper_runtime_write": "Writes local paper runtime state, ledger, JSONL archive, SQLite audit journal, pid, or logs only.",
    "security_or_supply_chain": "Runs scanners or dependency audits."
  },
  "preferred_readonly_entrypoints": [
    {
      "command": "python3 scripts/request.py --datasets --format json",
      "risk_class": "network_readonly",
      "schema": "tradecat.request_dataset_list.v1",
      "schema_version": "1.0.0"
    },
    {
      "command": "python3 scripts/request.py signal_flow --format json --limit 5",
      "risk_class": "network_readonly",
      "schema": "tradecat.request_result.v1",
      "schema_version": "1.0.0"
    },
    {
      "command": "python3 scripts/request.py anomaly_panel --format json --limit 0",
      "risk_class": "network_readonly",
      "schema": "tradecat.request_result.v1",
      "schema_version": "1.0.0"
    },
    {
      "command": "bash scripts/binance-public-snapshot.sh --symbols BTCUSDT,ETHUSDT --json",
      "risk_class": "network_readonly",
      "schema": "tradecat_auto.public_market_snapshot.v1",
      "schema_version": "1.0.0"
    },
    {
      "command": "bash scripts/binance-public-bundle.sh --symbols BTCUSDT,ETHUSDT --json",
      "risk_class": "network_readonly",
      "schema": "tradecat_auto.public_market_bundle_batch.v1",
      "schema_version": "1.0.0"
    },
    {
      "command": "bash scripts/run-tradecat.sh agent-market-context --symbol BTCUSDT --json",
      "risk_class": "network_readonly",
      "schema": "tradecat_auto.agent_market_context.v1",
      "schema_version": "1.0.0"
    },
    {
      "command": "bash scripts/run-tradecat.sh soft-layer --json",
      "risk_class": "local_readonly",
      "schema": "tradecat_auto.agent_soft_layer.v1",
      "schema_version": "1.0.0"
    },
    {
      "command": "bash scripts/run-tradecat.sh context-audit --input /path/to/agent-market-context.json --json",
      "risk_class": "local_readonly",
      "schema": "tradecat_auto.agent_market_context_audit.v1",
      "schema_version": "1.0.0"
    },
    {
      "command": "bash scripts/run-tradecat.sh paper-report --json",
      "risk_class": "local_readonly",
      "schema": "tradecat_auto.paper_report.v1",
      "schema_version": "1.0.0"
    },
    {
      "command": "bash scripts/run-tradecat.sh latest-cycle --json",
      "risk_class": "local_readonly",
      "schema": "tradecat_auto.latest_cycle_report.v1",
      "schema_version": "1.0.0"
    },
    {
      "command": "bash scripts/run-tradecat.sh latest-decision --json",
      "risk_class": "local_readonly",
      "schema": "tradecat_auto.latest_decision_report.v1",
      "schema_version": "1.0.0"
    },
    {
      "command": "bash scripts/start-auto-paper.sh status --json",
      "risk_class": "local_readonly",
      "schema": "tradecat_auto.paper_service_status.v1",
      "schema_version": "1.0.0"
    },
    {
      "command": "bash scripts/start-auto-paper.sh ops-check --json",
      "risk_class": "local_readonly",
      "schema": "tradecat_auto.paper_ops_report.v1",
      "schema_version": "1.0.0"
    },
    {
      "command": "bash scripts/run-tradecat.sh strategy-review --ledger-path .runtime/auto-paper/paper_ledger.json --archive-path .runtime/auto-paper/cycles.jsonl --json",
      "risk_class": "local_readonly",
      "schema": "tradecat_auto.strategy_review_report.v1",
      "schema_version": "1.0.0"
    }
  ],
  "preferred_mutating_entrypoints": [
    {
      "command": "bash scripts/run-tradecat.sh run-context --input /path/to/agent-market-context.json --mode paper --json",
      "risk_class": "paper_runtime_write",
      "schema": "tradecat_auto.run_once_report.v1",
      "schema_version": "1.0.0",
      "real_orders": false,
      "signed_requests": false,
      "reads_api_keys": false
    },
    {
      "command": "bash scripts/run-tradecat.sh run-loop --mode paper --agent-trade-thesis-path /path/to/agent_trade_thesis.json --once --json",
      "risk_class": "paper_runtime_write",
      "schema": "tradecat_auto.service_cycle.v1",
      "schema_version": "1.0.0",
      "real_orders": false,
      "signed_requests": false,
      "reads_api_keys": false
    },
    {
      "command": "bash scripts/start-auto-paper.sh start --json",
      "risk_class": "paper_runtime_write",
      "schema": "tradecat_auto.paper_service_status.v1",
      "schema_version": "1.0.0",
      "real_orders": false,
      "signed_requests": false,
      "reads_api_keys": false
    },
    {
      "command": "bash scripts/start-auto-paper.sh stop --json",
      "risk_class": "paper_runtime_write",
      "schema": "tradecat_auto.paper_service_status.v1",
      "schema_version": "1.0.0",
      "real_orders": false,
      "signed_requests": false,
      "reads_api_keys": false
    },
    {
      "command": "bash scripts/run-tradecat.sh strategy-review --ledger-path .runtime/auto-paper/paper_ledger.json --archive-path .runtime/auto-paper/cycles.jsonl --output-state-path .runtime/auto-paper/strategy_state.json --json",
      "risk_class": "paper_runtime_write",
      "schema": "tradecat_auto.strategy_review_report.v1",
      "schema_version": "1.0.0",
      "real_orders": false,
      "signed_requests": false,
      "reads_api_keys": false
    }
  ],
  "network_entrypoints": [
    {
      "command": "python3 scripts/request.py signal_flow --format json --limit 5",
      "risk_class": "network_readonly"
    },
    {
      "command": "python3 scripts/request.py anomaly_panel --format json --limit 0",
      "risk_class": "network_readonly"
    },
    {
      "command": "bash scripts/run-tradecat.sh market-universe --json",
      "risk_class": "network_readonly",
      "schema": "tradecat_auto.market_universe.v1"
    }
  ],
