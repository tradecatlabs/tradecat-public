{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecat.local/contracts/tradecat-auto-daily-paper-report.schema.json",
  "title": "TradeCat Auto Daily Paper Report",
  "description": "Daily paper/watch report from local paper ledger and service-cycle archive.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "ok",
    "date",
    "ledger_path",
    "archive_path",
    "ledger_summary",
    "cycle_counts",
    "cycle_count",
    "trades",
    "fills",
    "alerts",
    "safety"
  ],
  "properties": {
    "schema": {
      "const": "tradecat_auto.daily_paper_report.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "ok": {
      "type": "boolean"
    },
    "date": {
      "type": "string"
    },
    "ledger_path": {
      "type": "string"
    },
    "archive_path": {
      "type": "string"
    },
    "ledger_summary": {
      "type": "object",
      "additionalProperties": true
    },
    "cycle_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cycle_count": {
      "type": "integer",
      "minimum": 0
    },
    "trades": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "fills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "public_readonly_market_data",
        "public_readonly",
        "paper_or_watch_only",
        "real_orders",
        "signed_requests",
        "reads_api_keys",
        "binance_account_state"
      ],
      "properties": {
        "public_readonly_market_data": {
          "const": true
        },
        "public_readonly": {
          "const": true
        },
        "paper_or_watch_only": {
          "const": true
        },
        "real_orders": {
          "const": false
        },
        "signed_requests": {
          "const": false
        },
        "reads_api_keys": {
          "const": false
        },
        "binance_account_state": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
