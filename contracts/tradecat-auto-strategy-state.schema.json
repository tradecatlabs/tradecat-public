{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecat.local/contracts/tradecat-auto-strategy-state.schema.json",
  "title": "TradeCat Auto Strategy State",
  "description": "Local runtime paper/watch strategy filter generated from paper ledger outcomes.",
  "type": "object",
  "required": ["schema", "schema_version", "ok", "enabled", "policy", "provenance", "safety"],
  "properties": {
    "schema": {"const": "tradecat_auto.strategy_state.v1"},
    "schema_version": {"const": "1.0.0"},
    "ok": {"type": "boolean"},
    "enabled": {"type": "boolean"},
    "status": {"type": "string"},
    "generated_at": {"type": "string"},
    "closed_positions_count": {"type": "integer", "minimum": 0},
    "open_positions_count": {"type": "integer", "minimum": 0},
    "policy": {
      "type": "object",
      "properties": {
        "new_entries_enabled": {"type": "boolean"},
        "max_open_positions": {"type": ["integer", "null"], "minimum": 1},
        "max_positions_per_symbol": {"type": ["integer", "null"], "minimum": 1},
        "blocked_symbols": {"type": "array", "items": {"type": "string"}},
        "blocked_signal_types": {"type": "array", "items": {"type": "string"}},
        "blocked_sides": {"type": "array", "items": {"enum": ["LONG", "SHORT"]}}
      },
      "additionalProperties": true
    },
    "thresholds": {"type": "object", "additionalProperties": true},
    "provenance": {"type": "object", "additionalProperties": true},
    "safety": {
      "type": "object",
      "properties": {
        "public_readonly_market_data": {"const": true},
        "paper_or_watch_only": {"const": true},
        "real_orders": {"const": false},
        "signed_requests": {"const": false},
        "reads_api_keys": {"const": false},
        "binance_account_state": {"const": false}
      },
      "additionalProperties": true
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
