{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecat.local/contracts/tradecat-auto-public-market-bundle-batch.schema.json",
  "title": "TradeCat Auto Public Market Bundle Batch",
  "description": "Batch report for complete Binance public/read-only per-symbol market bundles with batchable requests merged.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "ok",
    "error_code",
    "real_orders",
    "signed_requests",
    "reads_api_keys",
    "symbols",
    "bundles",
    "provenance",
    "safety"
  ],
  "properties": {
    "schema": {"const": "tradecat_auto.public_market_bundle_batch.v1"},
    "schema_version": {"const": "1.0.0"},
    "ok": {"type": "boolean"},
    "error_code": {"type": ["string", "null"]},
    "real_orders": {"const": false},
    "signed_requests": {"const": false},
    "reads_api_keys": {"const": false},
    "base_url": {"type": "string"},
    "symbols": {"type": "array", "items": {"type": "string"}},
    "period": {"type": "string"},
    "batchable_endpoint_families": {"type": "array", "items": {"type": "string"}},
    "per_symbol_endpoint_families": {"type": "array", "items": {"type": "string"}},
    "bundles": {"type": "object", "additionalProperties": true},
    "market_snapshot": {"type": "object", "additionalProperties": true},
    "api_usage": {"type": "object", "additionalProperties": true},
    "provenance": {"type": "object", "additionalProperties": true},
    "safety": {
      "type": "object",
      "properties": {
        "public_readonly_market_data": {"const": true},
        "paper_or_watch_only": {"const": true},
        "real_orders": {"const": false},
        "signed_requests": {"const": false},
        "reads_api_keys": {"const": false},
        "binance_account_state": {"const": false}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
