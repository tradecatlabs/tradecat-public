{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecat.local/contracts/tradecat-auto-source-payload.schema.json",
  "title": "TradeCat Auto Source Payload",
  "description": "Public online-sheet source adapter payloads used as Agent trading signals.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "ok",
    "error_code",
    "provenance",
    "safety"
  ],
  "properties": {
    "schema": {
      "enum": [
        "tradecat_auto.sheet_events.v1",
        "tradecat_auto.signal_flow_events.v1",
        "tradecat_auto.anomaly_symbols.v1",
        "tradecat_auto.signal_events.v1",
        "tradecat_auto.anomaly_signal_events.v1",
        "tradecat_auto.source_error.v1"
      ]
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "ok": {
      "type": "boolean"
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "object",
        "string",
        "null"
      ],
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "safety": {
      "$ref": "#/$defs/safety"
    },
    "events": {
      "type": "array"
    },
    "symbols": {
      "type": "array"
    },
    "rejected": {
      "type": "array"
    },
    "duplicates": {
      "type": "array"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "safety": {
      "type": "object",
      "required": [
        "public_readonly_market_data",
        "public_readonly",
        "paper_or_watch_only",
        "real_orders",
        "signed_requests",
        "reads_api_keys",
        "binance_account_state"
      ],
      "properties": {
        "public_readonly_market_data": {
          "const": true
        },
        "public_readonly": {
          "const": true
        },
        "paper_or_watch_only": {
          "const": true
        },
        "real_orders": {
          "const": false
        },
        "signed_requests": {
          "const": false
        },
        "reads_api_keys": {
          "const": false
        },
        "binance_account_state": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  }
}
