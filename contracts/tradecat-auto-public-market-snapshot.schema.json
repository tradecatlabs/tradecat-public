{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecat.local/contracts/tradecat-auto-public-market-snapshot.schema.json",
  "title": "TradeCat Auto Public Market Snapshot",
  "description": "Batchable Binance USD-M public/read-only market snapshot fetched without API keys, signatures, account reads, or real orders.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "ok",
    "error_code",
    "real_orders",
    "signed_requests",
    "reads_api_keys",
    "symbols",
    "batchable_endpoint_families",
    "per_symbol_endpoint_families",
    "errors",
    "provenance",
    "safety"
  ],
  "properties": {
    "schema": {
      "const": "tradecat_auto.public_market_snapshot.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "ok": {
      "type": "boolean"
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "real_orders": {
      "const": false
    },
    "signed_requests": {
      "const": false
    },
    "reads_api_keys": {
      "const": false
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "batchable_endpoint_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "per_symbol_endpoint_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "safety": {
      "type": "object",
      "properties": {
        "public_readonly_market_data": {
          "const": true
        },
        "paper_or_watch_only": {
          "const": true
        },
        "real_orders": {
          "const": false
        },
        "signed_requests": {
          "const": false
        },
        "reads_api_keys": {
          "const": false
        },
        "binance_account_state": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
