{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecat.local/contracts/tradecat-auto-audit-journal-summary.schema.json",
  "title": "TradeCat Auto Audit Journal Summary",
  "description": "Summary of local SQLite paper/watch audit journal record counts and checksum-chain integrity.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "ok",
    "path",
    "storage",
    "record_count",
    "run_count",
    "event_type_counts",
    "chain_valid",
    "safety"
  ],
  "properties": {
    "schema": {
      "const": "tradecat_auto.audit_journal_summary.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "ok": {
      "type": "boolean"
    },
    "path": {
      "type": "string"
    },
    "storage": {
      "const": "sqlite3_local_audit_journal"
    },
    "sqlite_user_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "run_count": {
      "type": "integer",
      "minimum": 0
    },
    "event_type_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "latest_record_sha256": {
      "type": "string"
    },
    "chain_valid": {
      "type": "boolean"
    },
    "chain_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "safety": {
      "type": "object",
      "required": [
        "public_readonly_market_data",
        "public_readonly",
        "paper_or_watch_only",
        "real_orders",
        "signed_requests",
        "reads_api_keys",
        "binance_account_state"
      ],
      "properties": {
        "public_readonly_market_data": {
          "const": true
        },
        "public_readonly": {
          "const": true
        },
        "paper_or_watch_only": {
          "const": true
        },
        "real_orders": {
          "const": false
        },
        "signed_requests": {
          "const": false
        },
        "reads_api_keys": {
          "const": false
        },
        "binance_account_state": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
