{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecat.local/contracts/tradecat-auto-public-probe.schema.json",
  "title": "TradeCat Auto Public Probe",
  "description": "Public/read-only probe over TradeCat public sheet rows and Binance market endpoints.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "ok",
    "real_orders",
    "signed_requests",
    "reads_api_keys",
    "error_code",
    "mode",
    "tradecat_public",
    "binance_base_url",
    "selected_symbol",
    "universe",
    "events",
    "anomaly_symbols",
    "market_bundle",
    "raw_errors",
    "provenance",
    "safety"
  ],
  "properties": {
    "schema": {
      "const": "tradecat_auto.public_probe.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "ok": {
      "type": "boolean"
    },
    "real_orders": {
      "const": false
    },
    "signed_requests": {
      "const": false
    },
    "reads_api_keys": {
      "const": false
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "const": "public_readonly_no_credentials_no_orders"
    },
    "tradecat_public": {
      "type": "string"
    },
    "binance_base_url": {
      "type": "string"
    },
    "selected_symbol": {
      "type": "string"
    },
    "universe": {
      "type": "object",
      "additionalProperties": true
    },
    "events": {
      "type": "object",
      "additionalProperties": true
    },
    "anomaly_symbols": {
      "type": "object",
      "additionalProperties": true
    },
    "market_bundle": {
      "type": "object",
      "additionalProperties": true
    },
    "raw_errors": {
      "type": "array"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "const": "tradecat_auto.cli.probe_public"
        }
      },
      "additionalProperties": true
    },
    "safety": {
      "$ref": "#/$defs/safety"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "safety": {
      "type": "object",
      "required": [
        "public_readonly_market_data",
        "public_readonly",
        "paper_or_watch_only",
        "real_orders",
        "signed_requests",
        "reads_api_keys",
        "binance_account_state"
      ],
      "properties": {
        "public_readonly_market_data": {
          "const": true
        },
        "public_readonly": {
          "const": true
        },
        "paper_or_watch_only": {
          "const": true
        },
        "real_orders": {
          "const": false
        },
        "signed_requests": {
          "const": false
        },
        "reads_api_keys": {
          "const": false
        },
        "binance_account_state": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  }
}
