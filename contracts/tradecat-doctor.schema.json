{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecat.local/contracts/tradecat-doctor.schema.json",
  "title": "TradeCat Doctor",
  "allOf": [
    {
      "$ref": "tradecat-command-envelope.schema.json"
    }
  ],
  "required": ["schema", "schema_version", "ok", "cache_dir", "datasets", "errors", "warnings", "repair_hints"],
  "properties": {
    "schema": {
      "const": "tradecat.doctor.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "ok": {
      "type": "boolean"
    },
    "cache_dir": {
      "type": "string"
    },
    "datasets": {
      "type": "array"
    },
    "errors": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    },
    "repair_hints": {
      "type": "array"
    },
    "settings_health": {
      "type": "object"
    },
    "migration": {
      "type": "object"
    },
    "support_bundle": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
