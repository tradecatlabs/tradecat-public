{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecat.local/contracts/tradecat-auto-run-once-report.schema.json",
  "title": "TradeCat Auto Run Once Report",
  "description": "Single public/read-only paper/watch analysis and paper execution report.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "ok",
    "real_orders",
    "signed_requests",
    "reads_api_keys",
    "mode",
    "selected_symbol",
    "error_code",
    "provenance",
    "safety"
  ],
  "properties": {
    "schema": {
      "const": "tradecat_auto.run_once_report.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "ok": {
      "type": "boolean"
    },
    "real_orders": {
      "const": false
    },
    "signed_requests": {
      "const": false
    },
    "reads_api_keys": {
      "const": false
    },
    "mode": {
      "type": "string"
    },
    "selected_symbol": {
      "type": "string"
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "object",
        "string",
        "null"
      ],
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "safety": {
      "$ref": "#/$defs/safety"
    },
    "paper_sizing": {
      "$ref": "#/$defs/paper_sizing"
    },
    "risk_decision": {
      "$ref": "#/$defs/risk_decision"
    },
    "paper_execution": {
      "$ref": "#/$defs/paper_execution"
    },
    "enrichment": {
      "$ref": "#/$defs/stage_payload"
    },
    "signal": {
      "$ref": "#/$defs/stage_payload"
    },
    "strategy_intent": {
      "$ref": "#/$defs/stage_payload"
    },
    "signal_flow_events": {
      "$ref": "#/$defs/source_summary"
    },
    "anomaly_symbols": {
      "$ref": "#/$defs/source_summary"
    },
    "agent_market_context_audit": {
      "type": "object",
      "additionalProperties": true
    },
    "raw_errors": {
      "type": "array"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source_summary": {
      "type": "object",
      "required": [
        "ok",
        "error_code",
        "provenance",
        "safety"
      ],
      "properties": {
        "ok": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source_dataset_key": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": true
        },
        "safety": {
          "$ref": "#/$defs/safety"
        }
      },
      "additionalProperties": true
    },
    "stage_payload": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "error_code",
        "provenance",
        "safety"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": true
        },
        "safety": {
          "$ref": "#/$defs/safety"
        }
      },
      "additionalProperties": true
    },
    "paper_execution": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "ok",
        "real_orders",
        "signed_requests",
        "reads_api_keys",
        "status",
        "error_code",
        "provenance",
        "safety"
      ],
      "properties": {
        "schema": {
          "const": "tradecat_auto.paper_execution_report.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "ok": {
          "type": "boolean"
        },
        "real_orders": {
          "const": false
        },
        "signed_requests": {
          "const": false
        },
        "reads_api_keys": {
          "const": false
        },
        "status": {
          "enum": [
            "OPENED",
            "REJECTED"
          ]
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "const": "tradecat_auto.paper_broker.open_paper_position"
            }
          },
          "additionalProperties": true
        },
        "safety": {
          "$ref": "#/$defs/safety"
        }
      },
      "additionalProperties": true
    },
    "paper_sizing": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "ok",
        "source",
        "error_code",
        "provenance",
        "safety"
      ],
      "properties": {
        "schema": {
          "const": "tradecat_auto.paper_sizing_decision.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "ok": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "const": "tradecat_auto.pipeline.paper_sizing_decision"
            }
          },
          "additionalProperties": true
        },
        "safety": {
          "$ref": "#/$defs/safety"
        }
      },
      "additionalProperties": true
    },
    "risk_decision": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "ok",
        "real_orders",
        "signed_requests",
        "reads_api_keys",
        "decision",
        "mode",
        "reasons",
        "provenance",
        "safety"
      ],
      "properties": {
        "schema": {
          "const": "tradecat_auto.risk_decision.v1"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "ok": {
          "type": "boolean"
        },
        "real_orders": {
          "const": false
        },
        "signed_requests": {
          "const": false
        },
        "reads_api_keys": {
          "const": false
        },
        "decision": {
          "enum": [
            "ALLOW",
            "REJECT",
            "WATCH_ONLY"
          ]
        },
        "mode": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "type": "object",
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "const": "tradecat_auto.risk.evaluate_risk"
            }
          },
          "additionalProperties": true
        },
        "safety": {
          "$ref": "#/$defs/safety"
        }
      },
      "additionalProperties": true
    },
    "safety": {
      "type": "object",
      "required": [
        "public_readonly_market_data",
        "public_readonly",
        "paper_or_watch_only",
        "real_orders",
        "signed_requests",
        "reads_api_keys",
        "binance_account_state"
      ],
      "properties": {
        "public_readonly_market_data": {
          "const": true
        },
        "public_readonly": {
          "const": true
        },
        "paper_or_watch_only": {
          "const": true
        },
        "real_orders": {
          "const": false
        },
        "signed_requests": {
          "const": false
        },
        "reads_api_keys": {
          "const": false
        },
        "binance_account_state": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  }
}
