{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecat.local/contracts/tradecat-auto-run-once-report.schema.json",
  "title": "TradeCat Auto Run Once Report",
  "description": "Single public/read-only paper/watch analysis and paper execution report.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "ok",
    "real_orders",
    "signed_requests",
    "reads_api_keys",
    "mode",
    "selected_symbol",
    "error_code",
    "provenance",
    "safety"
  ],
  "properties": {
    "schema": {
      "const": "tradecat_auto.run_once_report.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "ok": {
      "type": "boolean"
    },
    "real_orders": {
      "const": false
    },
    "signed_requests": {
      "const": false
    },
    "reads_api_keys": {
      "const": false
    },
    "mode": {
      "type": "string"
    },
    "selected_symbol": {
      "type": "string"
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "object",
        "string",
        "null"
      ],
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "safety": {
      "$ref": "#/$defs/safety"
    },
    "paper_sizing": {
      "type": "object",
      "additionalProperties": true
    },
    "risk_decision": {
      "type": "object",
      "additionalProperties": true
    },
    "paper_execution": {
      "type": "object",
      "additionalProperties": true
    },
    "agent_market_context_audit": {
      "type": "object",
      "additionalProperties": true
    },
    "raw_errors": {
      "type": "array"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "safety": {
      "type": "object",
      "properties": {
        "public_readonly_market_data": {
          "const": true
        },
        "public_readonly": {
          "const": true
        },
        "paper_or_watch_only": {
          "const": true
        },
        "real_orders": {
          "const": false
        },
        "signed_requests": {
          "const": false
        },
        "reads_api_keys": {
          "const": false
        },
        "binance_account_state": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  }
}
