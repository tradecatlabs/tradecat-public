{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecat.local/contracts/tradecat-auto-service-cycle.schema.json",
  "title": "TradeCat Auto Service Cycle",
  "description": "One local paper/watch service cycle with event freshness, dedupe, optional paper ledger, archive, and audit journal effects.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "ok",
    "action",
    "error_code",
    "real_orders",
    "signed_requests",
    "reads_api_keys",
    "provenance",
    "safety"
  ],
  "properties": {
    "schema": {
      "const": "tradecat_auto.service_cycle.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "ok": {
      "type": "boolean"
    },
    "action": {
      "type": "string"
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "real_orders": {
      "const": false
    },
    "signed_requests": {
      "const": false
    },
    "reads_api_keys": {
      "const": false
    },
    "reason": {
      "type": "string"
    },
    "state": {
      "type": "object",
      "additionalProperties": true
    },
    "events": {
      "type": "object",
      "additionalProperties": true
    },
    "latest_event": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "pipeline_report": {
      "type": "object",
      "additionalProperties": true
    },
    "paper_ledger": {
      "type": "object",
      "additionalProperties": true
    },
    "audit_journal": {
      "type": "object",
      "additionalProperties": true
    },
    "raw_errors": {
      "type": "array"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "const": "tradecat_auto.service.run_service_cycle"
        }
      },
      "additionalProperties": true
    },
    "safety": {
      "$ref": "#/$defs/safety"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "safety": {
      "type": "object",
      "properties": {
        "public_readonly_market_data": {
          "const": true
        },
        "public_readonly": {
          "const": true
        },
        "paper_or_watch_only": {
          "const": true
        },
        "real_orders": {
          "const": false
        },
        "signed_requests": {
          "const": false
        },
        "reads_api_keys": {
          "const": false
        },
        "binance_account_state": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  }
}
