{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecat.local/contracts/tradecat-feature-bundle.schema.json",
  "title": "TradeCat Feature Bundle",
  "allOf": [
    {
      "$ref": "tradecat-command-envelope.schema.json"
    }
  ],
  "required": [
    "schema",
    "schema_version",
    "ok"
  ],
  "anyOf": [
    {
      "required": [
        "generated_at",
        "feature_window",
        "dataset_freshness",
        "symbols",
        "evidence",
        "risk_flags",
        "limitations"
      ],
      "properties": {
        "ok": {
          "const": true
        }
      }
    },
    {
      "required": ["error"],
      "properties": {
        "ok": {
          "const": false
        }
      }
    }
  ],
  "properties": {
    "schema": {
      "const": "tradecat.feature_bundle.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "ok": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string"
    },
    "feature_window": {
      "type": "object",
      "required": ["requested", "mode", "source_schema", "dataset_keys"],
      "properties": {
        "requested": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "const": "latest_cached"
        },
        "source_schema": {
          "type": "string",
          "const": "tradecat.analysis_report.v1"
        },
        "dataset_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "dataset_freshness": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dataset_key", "ok", "cache_state", "row_count"],
        "properties": {
          "dataset_key": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "cache_state": {
            "type": "string"
          },
          "row_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "features",
          "source_dataset_keys",
          "freshness",
          "evidence_ids",
          "confidence",
          "risk_flags",
          "limitations"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "kind",
                "value",
                "value_type",
                "source_dataset_keys",
                "evidence_ids",
                "confidence",
                "description"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "value": {},
                "value_type": {
                  "type": "string"
                },
                "source_dataset_keys": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "confidence": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "source_dataset_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "freshness": {
            "type": "array"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string"
          },
          "risk_flags": {
            "type": "array"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array"
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "$ref": "tradecat-error.schema.json"
    }
  },
  "additionalProperties": true
}
