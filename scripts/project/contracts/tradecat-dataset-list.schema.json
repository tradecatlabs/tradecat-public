{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecat.local/contracts/tradecat-dataset-list.schema.json",
  "title": "TradeCat Dataset List",
  "allOf": [
    {
      "$ref": "tradecat-command-envelope.schema.json"
    }
  ],
  "required": ["schema", "schema_version", "ok", "datasets"],
  "properties": {
    "schema": {
      "const": "tradecat.dataset_list.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "ok": {
      "type": "boolean"
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "active", "data_mode", "workbook_key", "tab_name", "gid"],
        "properties": {
          "key": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "data_mode": {
            "type": "string"
          },
          "workbook_key": {
            "type": "string"
          },
          "tab_name": {
            "type": "string"
          },
          "gid": {
            "type": ["string", "integer"]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
