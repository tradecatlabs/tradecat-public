{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecat.local/contracts/tradecat-analysis-report.schema.json",
  "title": "TradeCat Analysis Report",
  "allOf": [
    {
      "$ref": "tradecat-command-envelope.schema.json"
    }
  ],
  "required": [
    "schema",
    "schema_version",
    "ok",
    "generated_at",
    "analysis_window",
    "dataset_freshness",
    "observations",
    "candidate_symbols",
    "evidence",
    "risk_flags",
    "limitations"
  ],
  "anyOf": [
    {
      "properties": {
        "ok": {
          "const": true
        }
      }
    },
    {
      "required": ["error"],
      "properties": {
        "ok": {
          "const": false
        }
      }
    }
  ],
  "properties": {
    "schema": {
      "const": "tradecat.analysis_report.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "ok": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string"
    },
    "analysis_window": {
      "type": "object",
      "required": ["requested", "mode", "dataset_keys"],
      "properties": {
        "requested": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "const": "latest_cached"
        },
        "dataset_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "dataset_freshness": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dataset_key", "ok", "cache_state", "row_count"],
        "properties": {
          "dataset_key": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "cache_state": {
            "type": "string"
          },
          "row_count": {
            "type": "integer",
            "minimum": 0
          },
          "fetched_at": {
            "type": "string"
          },
          "content_hash": {
            "type": "string"
          },
          "data_mode": {
            "type": "string"
          },
          "quality_tier": {
            "type": "string"
          },
          "time_grain": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "dataset_key", "kind", "summary"],
        "properties": {
          "id": {
            "type": "string"
          },
          "dataset_key": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "metrics": {
            "type": "object"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "candidate_symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "rank", "source_dataset_keys", "evidence_ids"],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "source_dataset_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "dataset_key", "kind", "summary"],
        "properties": {
          "id": {
            "type": "string"
          },
          "dataset_key": {
            "type": "string"
          },
          "row_index": {
            "type": "integer"
          },
          "kind": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "values": {
            "type": "object"
          },
          "source_columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fetched_at": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "$ref": "tradecat-error.schema.json"
    }
  },
  "additionalProperties": true
}
