{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradecat.local/contracts/tradecat-auto-paper-report.schema.json",
  "title": "TradeCat Auto Paper Report",
  "description": "Local paper ledger summary with no Binance account state, signed requests, or real orders.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "ok",
    "real_orders",
    "signed_requests",
    "reads_api_keys",
    "error_code",
    "ledger_path",
    "provenance",
    "safety"
  ],
  "properties": {
    "schema": {
      "const": "tradecat_auto.paper_report.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "ok": {
      "type": "boolean"
    },
    "real_orders": {
      "const": false
    },
    "signed_requests": {
      "const": false
    },
    "reads_api_keys": {
      "const": false
    },
    "ledger_path": {
      "type": "string"
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "ledger_path"
      ],
      "properties": {
        "source": {
          "const": "local_tradecat_paper_ledger"
        },
        "ledger_path": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "safety": {
      "$ref": "#/$defs/safety"
    },
    "summary": {
      "type": "object",
      "additionalProperties": true
    },
    "paper_account_state": {
      "type": "object",
      "additionalProperties": true
    },
    "open_positions": {
      "type": "object",
      "additionalProperties": true
    },
    "closed_positions": {
      "type": "array"
    },
    "recent_paper_orders": {
      "type": "array"
    },
    "recent_fills": {
      "type": "array"
    },
    "equity_curve_tail": {
      "type": "array"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "safety": {
      "type": "object",
      "properties": {
        "public_readonly_market_data": {
          "const": true
        },
        "public_readonly": {
          "const": true
        },
        "paper_or_watch_only": {
          "const": true
        },
        "real_orders": {
          "const": false
        },
        "signed_requests": {
          "const": false
        },
        "reads_api_keys": {
          "const": false
        },
        "binance_account_state": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  }
}
