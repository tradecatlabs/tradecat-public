# TradeCat Public local configuration example.
# Copy values into your shell or a private ignored .env file only when needed.
# Do not add Binance keys, secrets, listen keys, account IDs, or real-order config here.

# Optional public network proxy for online sheet or public market-data reads.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost

# Local paper/watch runtime only. This path is ignored by Git.
TRADECAT_AUTO_PAPER_RUNTIME_DIR=.runtime/auto-paper
TRADECAT_AUTO_PAPER_CYCLE_TIMEOUT_SECONDS=6000
# Public paper cost fallback. Open entries prefer Binance USD-M public order-book depth;
# this fee fallback follows the Binance USD-M commission-rate documentation example.
TRADECAT_AUTO_PAPER_FEE_BPS=4
TRADECAT_AUTO_PAPER_SLIPPAGE_BPS=0
# Optional Agent/Hermes thesis path. Leave unset unless an Agent process writes this file.
TRADECAT_AUTO_PAPER_AGENT_TRADE_THESIS_PATH=
# Default paper-only autonomy bootstrap. Disable with 0 to wait for external Agent thesis only.
TRADECAT_AUTO_PAPER_AUTONOMY_ENABLED=1
TRADECAT_AUTO_PAPER_AUTONOMY_MARGIN_USDT=10
TRADECAT_AUTO_PAPER_AUTONOMY_LEVERAGE=1
TRADECAT_AUTO_PAPER_AUTONOMY_STOP_LOSS_BPS=150
TRADECAT_AUTO_PAPER_AUTONOMY_TAKE_PROFIT_BPS=300
TRADECAT_AUTO_PAPER_AUTONOMY_MAX_HOLDING_MINUTES=90
TRADECAT_AUTO_PAPER_AUTONOMY_DIRECTION_POLICY=sheet_signal_or_taker_flow
# Optional user-designed paper constraints/profile. Leave unset to use the ignored runtime default.
TRADECAT_AUTO_PAPER_AUTONOMY_PROFILE_PATH=
# Optional stale-signal cap. Leave unset to let Agent/TradeCat evaluate fetched signal age.
TRADECAT_AUTO_PAPER_MAX_EVENT_AGE_SECONDS=
TRADECAT_AUTO_PAPER_EVENT_LIMIT=0

# Optional local monitor bind address.
TRADECAT_AUTO_PAPER_MONITOR_HOST=127.0.0.1
TRADECAT_AUTO_PAPER_MONITOR_PORT=8765
